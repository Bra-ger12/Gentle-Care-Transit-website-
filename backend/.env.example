DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://gentlecare:changeme@localhost:5432/gentlecare_dev
TEST_DATABASE_NAME=gentlecare_test

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gentlecaretransit.org

TIME_ZONE=America/Chicago

# --- Needed starting Phase 2 (geocoding/routing) ---
GOOGLE_MAPS_API_KEY=
# Browser-side Maps key served to the static frontend (live tracking map). Leave
# blank to reuse GOOGLE_MAPS_API_KEY; in prod set a separate referrer-restricted key.
GOOGLE_MAPS_BROWSER_KEY=

# --- Needed starting Phase 2/5 (Celery + Channels infra) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CHANNELS_REDIS_URL=redis://localhost:6379/1
# Channel layer backend: "memory" (dev default, no Redis) or "redis" (prod / multi-process).
CHANNELS_BACKEND=memory

# --- Needed starting Phase 5 (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Later: S3 swap-in for local filesystem storage ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
